From 8efb7c90a04b877de2887d33692bc7a46ff5956b Mon Sep 17 00:00:00 2001
From: AyeedShaikh <ayeedxec@gmail.com>
Date: Sun, 18 Oct 2026 04:49:00 +0000
Subject: [PATCH 1/2] libbase: Build on FreeBSD with its own libc

libbase has no FreeBSD path in GetExecutablePath() or GetThreadId().
logging.cpp also defines getprogname(), but FreeBSD has it in its libc.

- file.cpp: GetExecutablePath() reads KERN_PROC_PATHNAME with sysctl(3).
- threads.cpp: GetThreadId() calls pthread_getthreadid_np().
- logging.cpp: do not define getprogname() on FreeBSD.

The project freebsd-android-native carries this patch (ADR 0002,
decision 1.7).
---
 file.cpp    | 9 +++++++++
 logging.cpp | 2 +-
 threads.cpp | 4 ++++
 3 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/file.cpp b/file.cpp
index c03d7e1..6338241 100644
--- a/file.cpp
+++ b/file.cpp
@@ -33,6 +33,9 @@
 #include <string>
 #include <vector>
 
+#if defined(__FreeBSD__)
+#include <sys/sysctl.h>
+#endif
 #if defined(__APPLE__)
 #include <mach-o/dyld.h>
 #endif
@@ -512,6 +515,12 @@ std::string GetExecutablePath() {
   if (result == 0 || result == sizeof(path) - 1) return "";
   path[PATH_MAX - 1] = 0;
   return path;
+#elif defined(__FreeBSD__)
+  int mib[4] = {CTL_KERN, KERN_PROC, KERN_PROC_PATHNAME, -1};
+  char path[PATH_MAX];
+  size_t path_len = sizeof(path);
+  if (sysctl(mib, 4, path, &path_len, nullptr, 0) == -1) return "";
+  return path;
 #elif defined(__EMSCRIPTEN__)
   abort();
 #else
diff --git a/logging.cpp b/logging.cpp
index 9204c0c..b4a4688 100644
--- a/logging.cpp
+++ b/logging.cpp
@@ -62,7 +62,7 @@ namespace android {
 namespace base {
 
 // BSD-based systems like Android/macOS have getprogname(). Others need us to provide one.
-#if !defined(__APPLE__) && !defined(__BIONIC__)
+#if !defined(__APPLE__) && !defined(__BIONIC__) && !defined(__FreeBSD__)
 static const char* getprogname() {
 #ifdef _WIN32
   static bool first = true;
diff --git a/threads.cpp b/threads.cpp
index 4197ff8..951605b 100644
--- a/threads.cpp
+++ b/threads.cpp
@@ -23,6 +23,8 @@
 #include <pthread.h>
 #elif defined(__linux__) && !defined(__ANDROID__)
 #include <syscall.h>
+#elif defined(__FreeBSD__)
+#include <pthread_np.h>
 #elif defined(_WIN32)
 #include <windows.h>
 #endif
@@ -39,6 +41,8 @@ uint64_t GetThreadId() {
   return tid;
 #elif defined(__linux__)
   return syscall(__NR_gettid);
+#elif defined(__FreeBSD__)
+  return pthread_getthreadid_np();
 #elif defined(_WIN32)
   return GetCurrentThreadId();
 #endif
