From fff6aee8d75862c9f8adf761ae0976dbdd58306b Mon Sep 17 00:00:00 2001
From: AyeedShaikh <ayeedxec@gmail.com>
Date: Sun, 18 Oct 2026 02:50:35 +0000
Subject: [PATCH 3/3] [libc++abi] Define __cxa_thread_atexit() for bionic on
 FreeBSD

libc++abi defines __cxa_thread_atexit() only on Linux and Fuchsia,
because other C libraries, for example the FreeBSD libc, have it.
bionic has only __cxa_thread_atexit_impl() and leaves the wrapper to
the C++ runtime.  bionic on FreeBSD needs the wrapper too: without it,
a shared object with a thread_local destructor does not link.

The project freebsd-android-native carries this patch (ADR 0002,
decision 1.7).
---
 libcxxabi/src/cxa_thread_atexit.cpp | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/libcxxabi/src/cxa_thread_atexit.cpp b/libcxxabi/src/cxa_thread_atexit.cpp
index 402a52c7..b87410a7 100644
--- a/libcxxabi/src/cxa_thread_atexit.cpp
+++ b/libcxxabi/src/cxa_thread_atexit.cpp
@@ -106,7 +106,9 @@ namespace {
 
 #endif // HAVE___CXA_THREAD_ATEXIT_IMPL
 
-#if defined(__linux__) || defined(__Fuchsia__)
+// bionic has __cxa_thread_atexit_impl() but, as on Android, leaves
+// __cxa_thread_atexit() to the C++ runtime, also on FreeBSD.
+#if defined(__linux__) || defined(__Fuchsia__) || defined(__BIONIC__)
 extern "C" {
 
   _LIBCXXABI_FUNC_VIS int __cxa_thread_atexit(Dtor dtor, void* obj, void* dso_symbol) throw() {
@@ -142,5 +144,5 @@ extern "C" {
 #endif // HAVE___CXA_THREAD_ATEXIT_IMPL
   }
 } // extern "C"
-#endif // defined(__linux__) || defined(__Fuchsia__)
+#endif // defined(__linux__) || defined(__Fuchsia__) || defined(__BIONIC__)
 } // namespace __cxxabiv1
