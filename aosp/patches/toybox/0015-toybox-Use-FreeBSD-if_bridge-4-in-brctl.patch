From 9e2bbbc4ace709ab5b4ef7c4187529568ca95bc2 Mon Sep 17 00:00:00 2001
From: AyeedShaikh <ayeedxec@gmail.com>
Date: Sat, 24 Oct 2026 08:43:45 +0530
Subject: [PATCH] toybox: Use FreeBSD if_bridge(4) in brctl

brctl uses the Linux bridge ioctls.  FreeBSD clones a bridge interface
with SIOCIFCREATE2 and removes it with SIOCIFDESTROY.  The commands of
the bridge go in a struct ifdrv with SIOCGDRVSPEC and SIOCSDRVSPEC.
brctl uses them for each command.  show finds the bridges by their link
type IFT_BRIDGE.

FreeBSD takes times in whole seconds, so brctl drops a fraction of a
second.  FreeBSD keeps the spanning tree state of each member, not of
the bridge.  stp sets it on each member that the bridge has now, and
show says yes when a member has it.

The project freebsd-android-native carries this patch (owner decision
O17).
---
 toys/pending/brctl.c | 185 +++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 185 insertions(+)

diff --git a/toys/pending/brctl.c b/toys/pending/brctl.c
index 1ff1372..c99d9b8 100644
--- a/toys/pending/brctl.c
+++ b/toys/pending/brctl.c
@@ -33,11 +33,195 @@ config BRCTL
 
 #define FOR_brctl
 #include "toys.h"
+#ifdef __FreeBSD__
+#include <ifaddrs.h>
+#include <net/if_bridgevar.h>
+#include <net/if_dl.h>
+#include <net/if_types.h>
+#else
 #include <linux/if_bridge.h>
+#endif
 
 GLOBALS(
     int sockfd;
 )
+
+#ifdef __FreeBSD__
+// FreeBSD's if_bridge(4) is a cloned interface, and SIOCGDRVSPEC and
+// SIOCSDRVSPEC carry its commands. Its times are whole seconds. It keeps the
+// spanning tree state of each member, not of the bridge: stp sets it on each
+// member there is now, and show says yes when a member has it.
+static void drvspec(char *br, int req, unsigned long cmd, void *data,
+  size_t len)
+{
+  struct ifdrv ifd;
+
+  memset(&ifd, 0, sizeof(ifd));
+  xstrncpy(ifd.ifd_name, br, IFNAMSIZ);
+  ifd.ifd_cmd = cmd;
+  ifd.ifd_len = len;
+  ifd.ifd_data = data;
+  xioctl(TT.sockfd, req, &ifd);
+}
+
+// Get the members of a bridge other than its span ports. Caller frees them.
+static int get_ports(char *bridge, struct ifbreq **ports)
+{
+  struct ifbifconf ifbic;
+  int i, n;
+
+  // A length of 0 asks for the length that the members need.
+  memset(&ifbic, 0, sizeof(ifbic));
+  drvspec(bridge, SIOCGDRVSPEC, BRDGGIFS, &ifbic, sizeof(ifbic));
+  *ports = (void *)(ifbic.ifbic_buf = xmalloc(ifbic.ifbic_len));
+  if (ifbic.ifbic_len)
+    drvspec(bridge, SIOCGDRVSPEC, BRDGGIFS, &ifbic, sizeof(ifbic));
+  for (i = n = 0; i < ifbic.ifbic_len/sizeof(**ports); i++)
+    if (!((*ports)[i].ifbr_ifsflags & IFBIF_SPAN)) (*ports)[n++] = (*ports)[i];
+
+  return n;
+}
+
+void br_show(char **argv)
+{
+  struct ifaddrs *ifs, *ifa;
+  struct ifbropreq op;
+  struct ifbreq *ports;
+  int i, n, stp;
+
+  if (getifaddrs(&ifs)) perror_exit("getifaddrs");
+  printf("bridge name\tbridge id\t\tSTP enabled\tinterfaces\n");
+  for (ifa = ifs; ifa; ifa = ifa->ifa_next) {
+    struct sockaddr_dl *sdl = (void *)ifa->ifa_addr;
+
+    if (!sdl || sdl->sdl_family != AF_LINK || sdl->sdl_type != IFT_BRIDGE)
+      continue;
+    drvspec(ifa->ifa_name, SIOCGDRVSPEC, BRDGPARAM, &op, sizeof(op));
+    n = get_ports(ifa->ifa_name, &ports);
+    for (i = stp = 0; i < n; i++) stp |= ports[i].ifbr_ifsflags & IFBIF_STP;
+
+    // The bridge id is the priority and then the MAC address.
+    printf("%s\t\t%.4x.%.12llx\t%s\t\t", ifa->ifa_name,
+      (unsigned)(op.ifbop_bridgeid>>48),
+      (unsigned long long)op.ifbop_bridgeid & 0xffffffffffffULL,
+      stp ? "yes" : "no");
+    for (i = 0; i < n; i++)
+      printf("%s%s", i ? "\n\t\t\t\t\t\t\t" : "", ports[i].ifbr_ifsname);
+    xputc('\n');
+    free(ports);
+  }
+  freeifaddrs(ifs);
+}
+
+void br_addbr(char **argv)
+{
+  struct ifreq ifr;
+
+  memset(&ifr, 0, sizeof(ifr));
+  strcpy(ifr.ifr_name, "bridge");
+  xioctl(TT.sockfd, SIOCIFCREATE2, &ifr);
+  if (strcmp(ifr.ifr_name, *argv)) {
+    ifr.ifr_data = *argv;
+    if (ioctl(TT.sockfd, SIOCSIFNAME, &ifr)) {
+      ioctl(TT.sockfd, SIOCIFDESTROY, &ifr);
+      perror_exit("%s", *argv);
+    }
+  }
+}
+
+void br_delbr(char **argv)
+{
+  struct ifreq ifr;
+
+  memset(&ifr, 0, sizeof(ifr));
+  xstrncpy(ifr.ifr_name, *argv, IFNAMSIZ);
+  xioctl(TT.sockfd, SIOCIFDESTROY, &ifr);
+}
+
+static void set_port(char **argv, unsigned long cmd, long cost, long prio)
+{
+  struct ifbreq req;
+
+  memset(&req, 0, sizeof(req));
+  xstrncpy(req.ifbr_ifsname, argv[1], IFNAMSIZ);
+  req.ifbr_path_cost = cost;
+  req.ifbr_priority = prio;
+  drvspec(argv[0], SIOCSDRVSPEC, cmd, &req, sizeof(req));
+}
+
+void br_addif(char **argv)
+{
+  set_port(argv, BRDGADD, 0, 0);
+}
+
+void br_delif(char **argv)
+{
+  set_port(argv, BRDGDEL, 0, 0);
+}
+
+void br_set_path_cost(char **argv)
+{
+  set_port(argv, BRDGSIFCOST, atolx_range(argv[2], 0, UINT_MAX), 0);
+}
+
+void br_set_port_prio(char **argv)
+{
+  set_port(argv, BRDGSIFPRIO, 0, atolx_range(argv[2], 0, 255));
+}
+
+static void set_param(char *br, unsigned long cmd, long val)
+{
+  struct ifbrparam param;
+
+  memset(&param, 0, sizeof(param));
+  if (cmd == BRDGSTO) param.ifbrp_ctime = val;
+  else if (cmd == BRDGSPRI) param.ifbrp_prio = val;
+  else param.ifbrp_hellotime = val;
+  drvspec(br, SIOCSDRVSPEC, cmd, &param, sizeof(param));
+}
+
+void br_set_ageing_time(char **argv)
+{
+  set_param(argv[0], BRDGSTO, xparsetime(argv[1], 0, 0));
+}
+
+void br_set_fwd_delay(char **argv)
+{
+  set_param(argv[0], BRDGSFD, xparsetime(argv[1], 0, 0));
+}
+
+void br_set_hello_time(char **argv)
+{
+  set_param(argv[0], BRDGSHT, xparsetime(argv[1], 0, 0));
+}
+
+void br_set_max_age(char **argv)
+{
+  set_param(argv[0], BRDGSMA, xparsetime(argv[1], 0, 0));
+}
+
+void br_set_bridge_prio(char **argv)
+{
+  set_param(argv[0], BRDGSPRI, atolx_range(argv[1], 0, 65535));
+}
+
+void br_set_stp(char **argv)
+{
+  char *ss[] = {"0", "no", "off", "1", "yes", "on"};
+  struct ifbreq *ports;
+  int i, n;
+
+  for (i = 0; i < ARRAY_LEN(ss); i++) if (!strcmp(ss[i], argv[1])) break;
+  if (i == ARRAY_LEN(ss)) error_exit("invalid stp state");
+  n = get_ports(argv[0], &ports);
+  while (n--) {
+    if (i < 3) ports[n].ifbr_ifsflags &= ~IFBIF_STP;
+    else ports[n].ifbr_ifsflags |= IFBIF_STP;
+    drvspec(argv[0], SIOCSDRVSPEC, BRDGSIFFLGS, ports+n, sizeof(*ports));
+  }
+  free(ports);
+}
+#else
 #define MAX_BRIDGES 1024 //same is no of ports supported
 
 static void get_ports(char *bridge, int *indices)
@@ -291,6 +475,7 @@ void br_set_port_prio(char **argv)
   set_cost_prio(argv[0], argv[1], BRCTL_SET_PORT_PRIORITY, prio);
 
 }
+#endif
 
 void brctl_main(void)
 {
-- 
