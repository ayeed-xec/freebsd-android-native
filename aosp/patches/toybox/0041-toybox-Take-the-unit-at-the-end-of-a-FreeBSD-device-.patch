From 794c5409dda5d4bf76603fc0698e64d811e84861 Mon Sep 17 00:00:00 2001
From: AyeedShaikh <ayeedxec@gmail.com>
Date: Thu, 29 Oct 2026 23:44:52 +0530
Subject: [PATCH] toybox: Take the unit at the end of a FreeBSD device name

controller_desc() split a device name at its first digit, but a FreeBSD
driver name can have digits, for example ig4iic0.  The unit is the
number at the end of the name, so split there.

The project freebsd-android-native carries this patch (owner decision
O17).
---
 lib/portability.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/lib/portability.c b/lib/portability.c
index ae06642..0f7d456 100644
--- a/lib/portability.c
+++ b/lib/portability.c
@@ -771,7 +771,8 @@ void controller_desc(char *name, char *desc, int size)
   xstrncpy(dev, name, sizeof(dev));
   *desc = 0;
   for (i = 0; i < 3; i++) {
-    n = strcspn(dev, "0123456789");
+    // The unit is the number at the end: a driver name can have digits.
+    for (n = strlen(dev); n && isdigit(dev[n-1]); n--);
     snprintf(oid, sizeof(oid), "dev.%.*s.%s.%s", n, dev, dev+n,
       i < 2 ? "%parent" : "%desc");
     buf = i < 2 ? dev : desc;
-- 
