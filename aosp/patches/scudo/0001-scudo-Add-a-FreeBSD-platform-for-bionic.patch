+//===-- freebsd.cpp ---------------------------------------------*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "platform.h"
+
+#if SCUDO_FREEBSD
+
+#include "common.h"
+#include "mem_map.h"
+#include "mutex.h"
+#include "report_linux.h"
+#include "string_utils.h"
+
+#include <errno.h>
+#include <sched.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/random.h>
+#include <sys/umtx.h>
+#include <time.h>
+#include <unistd.h>
+
+namespace scudo {
+
+#if !defined(SCUDO_PAGE_SIZE)
+uptr getPageSize() { return static_cast<uptr>(getpagesize()); }
+#endif
+
+void NORETURN die() { abort(); }
+
+void *map(void *Addr, uptr Size, UNUSED const char *Name, uptr Flags,
+          UNUSED MapPlatformData *Data) {
+  CHECK_EQ(Flags & MAP_MEMTAG, 0U);
+  const bool NoAccess = Flags & MAP_NOACCESS;
+  const int Prot = NoAccess ? PROT_NONE : PROT_READ | PROT_WRITE;
+  // A guard reservation must not include MAP_PRIVATE or MAP_ANONYMOUS.
+  int MapFlags = NoAccess ? MAP_GUARD : MAP_PRIVATE | MAP_ANONYMOUS;
+  if (Addr)
+    MapFlags |= MAP_FIXED;
+  void *P = mmap(Addr, Size, Prot, MapFlags, -1, 0);
+  if (P == MAP_FAILED) {
+    if (!(Flags & MAP_ALLOWNOMEM) || errno != ENOMEM)
+      reportMapError(errno == ENOMEM ? Size : 0);
+    return nullptr;
+  }
+  return P;
+}
+
+void unmap(void *Addr, uptr Size, UNUSED uptr Flags,
+           UNUSED MapPlatformData *Data) {
+  if (munmap(Addr, Size) != 0)
+    reportUnmapError(reinterpret_cast<uptr>(Addr), Size);
+}
+
+void setMemoryPermission(uptr Addr, uptr Size, uptr Flags,
+                         UNUSED MapPlatformData *Data) {
+  CHECK_EQ(Flags & MAP_MEMTAG, 0U);
+  const int Prot = Flags & MAP_NOACCESS ? PROT_NONE : PROT_READ | PROT_WRITE;
+  if (mprotect(reinterpret_cast<void *>(Addr), Size, Prot) != 0)
+    reportProtectError(Addr, Size, Prot);
+}
+
+void releasePagesToOS(uptr BaseAddress, uptr Offset, uptr Size,
+                      UNUSED MapPlatformData *Data) {
+  // MADV_FREE can retain old contents. The default memory class needs zeros.
+  void *Addr = reinterpret_cast<void *>(BaseAddress + Offset);
+  if (mmap(Addr, Size, PROT_READ | PROT_WRITE,
+           MAP_FIXED | MAP_PRIVATE | MAP_ANONYMOUS, -1, 0) == MAP_FAILED)
+    reportMapError(errno == ENOMEM ? Size : 0);
+}
+
+s64 MemMapDefault::getResidentPagesImpl(uptr From, uptr Size) {
+  if (Size == 0)
+    return 0;
+  unsigned char PageData[256];
+  // FreeBSD's MINCORE_INCORE is bit 0; other bits describe page activity.
+  constexpr unsigned char InCore = 0x1;
+  const uptr PageSize = getPageSizeCached();
+  uptr CurrentAddress = roundDown(From, PageSize);
+  const uptr LastAddress = roundUp(From + Size, PageSize);
+  s64 ResidentPages = 0;
+  while (CurrentAddress < LastAddress) {
+    const uptr Length =
+        Min(LastAddress - CurrentAddress, sizeof(PageData) * PageSize);
+    if (mincore(reinterpret_cast<void *>(CurrentAddress), Length, PageData) !=
+        0) {
+      ScopedString Str;
+      Str.append("mincore failed: %s\n", strerror(errno));
+      Str.output();
+      return -1;
+    }
+    for (uptr I = 0; I < Length / PageSize; ++I)
+      if (PageData[I] & InCore)
+        ++ResidentPages;
+    CurrentAddress += Length;
+  }
+  return ResidentPages;
+}
+
+const char *getEnv(const char *Name) { return getenv(Name); }
+
+namespace {
+enum State : u32 { Unlocked = 0, Locked = 1, Sleeping = 2 };
+}
+
+bool HybridMutex::tryLock() {
+  return atomic_compare_exchange_strong(&M, Unlocked, Locked,
+                                        memory_order_acquire) == Unlocked;
+}
+
+void HybridMutex::lockSlow() {
+  u32 V = atomic_compare_exchange_strong(&M, Unlocked, Locked,
+                                         memory_order_acquire);
+  if (V == Unlocked)
+    return;
+  if (V != Sleeping)
+    V = atomic_exchange(&M, Sleeping, memory_order_acquire);
+  while (V != Unlocked) {
+    _umtx_op(&M, UMTX_OP_WAIT_UINT_PRIVATE, Sleeping, nullptr, nullptr);
+    V = atomic_exchange(&M, Sleeping, memory_order_acquire);
+  }
+}
+
+void HybridMutex::unlock() {
+  if (atomic_fetch_sub(&M, 1U, memory_order_release) != Locked) {
+    atomic_store(&M, Unlocked, memory_order_release);
+    _umtx_op(&M, UMTX_OP_WAKE_PRIVATE, 1, nullptr, nullptr);
+  }
+}
+
+void HybridMutex::assertHeldImpl() {
+  CHECK(atomic_load(&M, memory_order_acquire) != Unlocked);
+}
+
+u64 getMonotonicTime() {
+  timespec TS;
+  if (clock_gettime(CLOCK_MONOTONIC, &TS) != 0)
+    die();
+  return static_cast<u64>(TS.tv_sec) * 1000000000ULL +
+         static_cast<u64>(TS.tv_nsec);
+}
+
+u64 getMonotonicTimeFast() { return getMonotonicTime(); }
+
+u32 getNumberOfCPUs() {
+  cpu_set_t CPUs;
+  if (sched_getaffinity(0, sizeof(CPUs), &CPUs) != 0)
+    return 0;
+  return static_cast<u32>(CPU_COUNT(&CPUs));
+}
+
+u32 getThreadID() { return static_cast<u32>(gettid()); }
+
+bool getRandom(void *Buffer, uptr Length, bool Blocking) {
+  if (!Buffer || !Length || Length > MaxRandomLength)
+    return false;
+  return getrandom(Buffer, Length, Blocking ? 0 : GRND_NONBLOCK) ==
+         static_cast<ssize_t>(Length);
+}
+
+// Allocation free syslog-like API.
+extern "C" WEAK int async_safe_write_log(int pri, const char *tag,
+                                         const char *msg);
+
+void outputRaw(const char *Buffer) {
+  if (&async_safe_write_log) {
+    constexpr s32 AndroidLogInfo = 4;
+    constexpr uptr MaxLength = 1024U;
+    char LocalBuffer[MaxLength];
+    while (strlen(Buffer) > MaxLength) {
+      uptr P;
+      for (P = MaxLength - 1; P > 0; P--) {
+        if (Buffer[P] == '\n') {
+          memcpy(LocalBuffer, Buffer, P);
+          LocalBuffer[P] = '\0';
+          async_safe_write_log(AndroidLogInfo, "scudo", LocalBuffer);
+          Buffer = &Buffer[P + 1];
+          break;
+        }
+      }
+      // If no newline was found, just log the buffer.
+      if (P == 0)
+        break;
+    }
+    async_safe_write_log(AndroidLogInfo, "scudo", Buffer);
+  } else {
+    (void)write(2, Buffer, strlen(Buffer));
+  }
+}
+
+extern "C" WEAK void android_set_abort_message(const char *);
+
+void setAbortMessage(const char *Message) {
+  if (&android_set_abort_message)
+    android_set_abort_message(Message);
+}
+
+} // namespace scudo
+
+#endif // SCUDO_FREEBSD
