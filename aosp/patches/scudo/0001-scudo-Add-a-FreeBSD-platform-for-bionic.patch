 standalone/mutex.h          |   2 +-
 standalone/platform.h       |   6 ++
 standalone/report_linux.cpp |   4 +-
 standalone/report_linux.h   |   4 +-
 10 files changed, 246 insertions(+), 6 deletions(-)
 create mode 100644 standalone/freebsd.cpp
