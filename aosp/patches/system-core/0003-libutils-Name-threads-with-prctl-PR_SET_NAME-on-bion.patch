From b03df07388fbca6f5088d20756ccebf2961a17c2 Mon Sep 17 00:00:00 2001
From: AyeedShaikh <ayeedxec@gmail.com>
Date: Sun, 1 Nov 2026 07:52:03 +0000
Subject: [PATCH] libutils: Name threads with prctl(PR_SET_NAME) on bionic for
 FreeBSD

androidSetThreadName() sets the name only under __linux__, so on
bionic for FreeBSD it did nothing and its argument was unused, which
-Wextra and -Werror reject.  bionic for FreeBSD has prctl(PR_SET_NAME)
on the native thr_set_name(2), so take the Linux path on every
Android target.

The project freebsd-android-native carries this patch (ADR 0004,
gap T15-G3, approved by the owner on 2026-11-01).
---
 libutils/Threads.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/libutils/Threads.cpp b/libutils/Threads.cpp
index 111d46a..8f11677 100644
--- a/libutils/Threads.cpp
+++ b/libutils/Threads.cpp
@@ -30,7 +30,7 @@
 # define HAVE_CREATETHREAD  // Cygwin, vs. HAVE__BEGINTHREADEX for MinGW
 #endif
 
-#if defined(__linux__)
+#if defined(__linux__) || defined(__ANDROID__)
 #include <sys/prctl.h>
 #endif
 
@@ -103,7 +103,7 @@ static void* _Nonnull libutil_thread_trampoline(void* _Nonnull arg) {
 }
 
 void androidSetThreadName(const char* name) {
-#if defined(__linux__)
+#if defined(__linux__) || defined(__ANDROID__)
     // Mac OS doesn't have this, and we build libutil for the host too
     int hasAt = 0;
     int hasDot = 0;
-- 
2.56.0

