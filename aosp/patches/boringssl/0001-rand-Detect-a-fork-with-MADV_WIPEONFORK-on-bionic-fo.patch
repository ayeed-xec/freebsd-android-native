From 9587198f0146dcb16b261f0499a3db3bfc76e3d6 Mon Sep 17 00:00:00 2001
From: AyeedShaikh <ayeedxec@gmail.com>
Date: Sat, 24 Oct 2026 06:54:59 +0000
Subject: [PATCH] rand: Detect a fork with MADV_WIPEONFORK on bionic for
 FreeBSD

BoringSSL selects MADV_WIPEONFORK only for Linux.  On FreeBSD it uses
pthread_atfork(), which a child of _Fork() or of clone() without
CLONE_VM does not run, so such a child keeps the random state of its
parent.  bionic on FreeBSD maps MADV_WIPEONFORK to one minherit(2) call
with INHERIT_ZERO, the same semantics for a private anonymous page.
Select the madvise path for Android on FreeBSD too.

fork_detect_test.cc tests OPENSSL_FORK_DETECTION, which only
rand/internal.h defines, and did not include that file.  Include it, so
that ForkDetect.Test runs.

The project freebsd-android-native carries this patch (register row
T13-G1, owner decision O19).
---
 src/crypto/rand/fork_detect_test.cc | 1 +
 src/crypto/rand/internal.h          | 4 +++-
 2 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/crypto/rand/fork_detect_test.cc b/src/crypto/rand/fork_detect_test.cc
index 565519b..4338a54 100644
--- a/src/crypto/rand/fork_detect_test.cc
+++ b/src/crypto/rand/fork_detect_test.cc
@@ -15,6 +15,7 @@
 #include <openssl/base.h>
 
 #include "../bcm_support.h"
+#include "internal.h"
 
 // TSAN cannot cope with this test and complains that "starting new threads
 // after multi-threaded fork is not supported".
diff --git a/src/crypto/rand/internal.h b/src/crypto/rand/internal.h
index 9ed080f..97e3286 100644
--- a/src/crypto/rand/internal.h
+++ b/src/crypto/rand/internal.h
@@ -34,10 +34,12 @@
 #define OPENSSL_RAND_GETENTROPY
 #endif
 
-#if defined(OPENSSL_LINUX)
+#if defined(OPENSSL_LINUX) || \
+    (defined(OPENSSL_ANDROID) && defined(OPENSSL_FREEBSD))
 // On linux we use MADVISE instead of pthread_atfork(), due
 // to concerns about clone() being used for address space
 // duplication.
+// bionic on FreeBSD maps MADV_WIPEONFORK to minherit(2) INHERIT_ZERO.
 #define OPENSSL_FORK_DETECTION
 #define OPENSSL_FORK_DETECTION_MADVISE
 #elif defined(OPENSSL_MACOS) || defined(OPENSSL_IOS) || \
-- 
2.56.0

