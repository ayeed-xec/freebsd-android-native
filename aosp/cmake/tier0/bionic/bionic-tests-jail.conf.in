# jail.conf(5) for the bionic_unit_tests ctest entry; tests.cmake fills in
# the paths.  The root is the Android root.  The runtime and i18n APEXes
# and /system come read-only from this build, tzdata from the host, and
# /bin is a symbolic link to /system/bin, as on Android.  Of the build tree
# only jail/ appears, read-only and at its own path: propd, svcstart and
# the programs that run-in-jail.sh starts.  The test suites are copied to
# /data/local/tmp, as "adb push" does.  No FreeBSD program is in the jail:
# toybox and sh are in /system/bin.
#
# As on a device, dmesg reads the kernel message buffer and a program can
# lock its memory, within RLIMIT_MEMLOCK: allow.read_msgbuf and
# allow.mlock.
#
# devfs cannot hold a directory that a program makes, so /dev/__properties__
# and /dev/socket are devfs symbolic links into a tmpfs at /mnt/dev.  The
# devfs ruleset hides new entries, so a rule unhides the two links.  As init
# does on a device, propd makes the property area there and serves
# /dev/socket/property_service until the jail goes away.  /proc and /sys are
# aprocfs(4) and asysfs(4), the Linux layout that Android reads, so the
# host modules aprocfs.ko and asysfs.ko must be loaded.  As on Android,
# /dev/stdin, /dev/stdout and /dev/stderr link to /proc/self/fd: a rule
# hides the devfs links to fd/0, fd/1 and fd/2, and new links replace them.
#
# After propd, svcstart starts logd with the lines of logd.rc: the sockets
# logd, logdr and logdw in /dev/socket, the logd user and groups, and
# priority 10.  As logd.rc does, /dev/event-log-tags is a file that logd
# owns; it is a devfs link to /mnt/dev, as /dev/socket is.  /etc links to
# /system/etc, as on Android.
#
# /data is a directory of the Android root, not a tmpfs: as on a device it
# is a disk file system, and linker64 does not check the namespace of a
# library on tmpfs.  At each start /data, /data/local and /data/local/tmp
# get the owners and modes that init gives them.  The test runner then
# gives /data/local/tmp to the user that runs the tests, who has the part
# of the shell user.
# The jail owns a network stack with a dual-stack loopback named lo.
# The host keeps its IPv6 socket default.

bionic_tests {
	path = "@ANDROID_JAIL_ROOT@";
	host.hostname = "localhost";
	vnet;
	persist;
	allow.mlock;
	allow.read_msgbuf;
	exec.created = "ifconfig -j bionic_tests lo0 name lo";
	exec.created += "ifconfig -j bionic_tests lo inet 127.0.0.1/8 up";
	exec.created += "sysctl -j bionic_tests net.inet6.ip6.v6only=0";
	exec.prepare = "mkdir -p $path/apex/com.android.i18n \
	    $path/apex/com.android.runtime $path/apex/com.android.tzdata \
	    $path/system $path/dev $path/mnt/dev \
	    $path/proc $path/sys $path/tmp $path@JAIL_BIN@";
	# An older root has an empty directory here, which -F replaces.
	exec.prepare += "ln -sFh /system/bin $path/bin";
	exec.prepare += "ln -sFh /system/etc $path/etc";
	exec.prepare += "install -d -o 1000 -g 1000 -m 0771 $path/data";
	exec.prepare += "install -d -o 0 -g 0 -m 0751 $path/data/local";
	exec.prepare += "install -d -o 0 -g 0 -m 0771 $path/data/local/tmp";
	mount.devfs;
	mount = "@GEN@/android-root/apex/com.android.runtime \
	    $path/apex/com.android.runtime nullfs ro 0 0";
	mount += "@GEN@/android-root/apex/com.android.i18n \
	    $path/apex/com.android.i18n nullfs ro 0 0";
	mount += "/apex/com.android.tzdata $path/apex/com.android.tzdata \
	    nullfs ro 0 0";
	mount += "@GEN@/android-root/system $path/system nullfs ro 0 0";
	mount += "@JAIL_BIN@ $path@JAIL_BIN@ nullfs ro 0 0";
	mount += "tmpfs $path/tmp tmpfs rw,mode=1777 0 0";
	mount += "tmpfs $path/mnt/dev tmpfs \
	    rw,mode=0755,uid=0,gid=0,size=1m 0 0";
	mount += "aprocfs $path/proc aprocfs rw 0 0";
	mount += "asysfs $path/sys asysfs ro 0 0";
	exec.prestart = "mkdir -m 0711 $path/mnt/dev/__properties__";
	exec.prestart += "mkdir -m 0755 $path/mnt/dev/socket";
	exec.prestart += "ln -s /mnt/dev/__properties__ \
	    $path/dev/__properties__";
	exec.prestart += "ln -s /mnt/dev/socket $path/dev/socket";
	exec.prestart += "devfs -m $path/dev rule apply path __properties__ \
	    unhide";
	exec.prestart += "devfs -m $path/dev rule apply path socket unhide";
	exec.prestart += "devfs -m $path/dev rule apply path stdin hide";
	exec.prestart += "devfs -m $path/dev rule apply path stdout hide";
	exec.prestart += "devfs -m $path/dev rule apply path stderr hide";
	exec.prestart += "ln -s /proc/self/fd/0 $path/dev/stdin";
	exec.prestart += "ln -s /proc/self/fd/1 $path/dev/stdout";
	exec.prestart += "ln -s /proc/self/fd/2 $path/dev/stderr";
	exec.prestart += "printf '# content owned by logd\\n' > \
	    $path/mnt/dev/event-log-tags";
	exec.prestart += "chown 1036:1036 $path/mnt/dev/event-log-tags";
	exec.prestart += "chmod 0644 $path/mnt/dev/event-log-tags";
	exec.prestart += "ln -s /mnt/dev/event-log-tags \
	    $path/dev/event-log-tags";
	exec.prestart += "devfs -m $path/dev rule apply path event-log-tags \
	    unhide";
	exec.start = "@JAIL_BIN@/propd @JAIL_BIN@/property_contexts";
	exec.start += "@JAIL_BIN@/svcstart -s logd:stream:0666:1036:1036 \
	    -s logdr:seqpacket:0666:1036:1036 \
	    -s logdw:dgram+passcred:0222:1036:1036 -g 1036,1000,1032,3009 \
	    -p 10 -u 1036 /system/bin/logd";
}
