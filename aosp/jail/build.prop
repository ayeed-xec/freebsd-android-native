#
# /system/build.prop of the Android root: the build-time properties of the
# system partition, one name=value a line.  propd loads it at start, as
# init loads the build.prop files of the partitions.

# The time zone of the system.  A product sets it here, and the user
# setting in /data overrides it on a device.  bionic's tzalloc(NULL) and
# localtime() read it when $TZ is not set.
persist.sys.timezone=GMT

# libcutils makes ashmem regions with memfd_create(2), as Android 17
# devices do.  FreeBSD has no /dev/ashmem device.
sys.use_memfd=true

# logd: FreeBSD has no /proc/kmsg to read and no NETLINK_AUDIT family, so
# the kernel log reader and the audit reader of logd are off.
ro.logd.kernel=false
ro.logd.auditd=false
